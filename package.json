{
	"name": "@cldmv/uuid",
	"version": "1.3.0",
	"description": "Extended RFC 4122 and RFC 9562 UUID implementation with custom variant structures, issuer-based identification, and timestamp variants",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/src/index.d.mts",
	"exports": {
		".": {
			"uuid-dev": {
				"types": "./types/src/index.d.mts",
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./main": {
			"uuid-dev": {
				"types": "./types/src/index.d.mts",
				"import": "./src/main.mjs"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/main.mjs"
		},
		"./rng": {
			"uuid-dev": {
				"browser": "./src/lib/rng-browser.mjs",
				"import": "./src/lib/rng.mjs"
			},
			"browser": {
				"types": "./types/src/lib/rng-browser.d.mts",
				"default": "./dist/lib/rng-browser.mjs"
			},
			"types": "./types/src/lib/rng.d.mts",
			"import": "./dist/lib/rng.mjs"
		},
		"./bytes": {
			"uuid-dev": {
				"browser": "./src/lib/bytes-browser.mjs",
				"import": "./src/lib/bytes.mjs"
			},
			"browser": {
				"types": "./types/src/lib/bytes-browser.d.mts",
				"default": "./dist/lib/bytes-browser.mjs"
			},
			"types": "./types/src/lib/bytes.d.mts",
			"import": "./dist/lib/bytes.mjs"
		},
		"./hash": {
			"uuid-dev": {
				"browser": "./src/lib/hash-browser.mjs",
				"import": "./src/lib/hash.mjs"
			},
			"browser": {
				"types": "./types/src/lib/hash-browser.d.mts",
				"default": "./dist/lib/hash-browser.mjs"
			},
			"types": "./types/src/lib/hash.d.mts",
			"import": "./dist/lib/hash.mjs"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#bytes-type": {
			"types": {
				"browser": "./typings/bytes.d.mts",
				"node": "./typings/bytes-node.d.mts",
				"default": "./typings/bytes.d.mts"
			}
		}
	},
	"type": "module",
	"engines": {
		"node": ">=16.12.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.0",
			"onFail": "error"
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
		"build:ci": "npm run lint --if-present && npm run format:check --if-present && npm run types:build && npm run build",
		"build:types": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\" && tsc --project .configs/tsconfig.dts.jsonc",
		"prepack": "npm run build",
		"demo": "node scripts/demo-custom-uuids.mjs",
		"test": "node tests/run-vitest.mjs && npm run test:cjs && npm run test:types",
		"test:cjs": "npm run build && node --conditions=uuid-dev --test tests/cjs/entry.test.cjs",
		"test:types": "npm run build && node --test tests/types/consumer.test.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet && npm run test:cjs && npm run test:types",
		"ci:coverage": "npm run coverage",
		"fix:headers": "fix-headers --config .configs/fix-headers.json",
		"types:build": "tsc -p .configs/tsconfig.dts.jsonc --noCheck",
		"types:check": "tsc -p .configs/tsconfig.dts.jsonc --noEmit"
	},
	"keywords": [
		"uuid",
		"guid",
		"rfc4122",
		"identifier",
		"custom-uuid",
		"timestamp",
		"issuer",
		"variant",
		"entropy",
		"collision-resistant",
		"nodejs",
		"esm"
	],
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"license": "Apache-2.0",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/uuid.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/uuid/issues"
	},
	"homepage": "https://github.com/CLDMV/uuid#readme",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/",
		"typings/",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./src/main.mjs",
		"./dist/main.mjs"
	],
	"devDependencies": {
		"@cldmv/configs": "^1.3.0",
		"@cldmv/fix-headers": "^2.2.4",
		"@cldmv/vitest-runner": "^1.5.6",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.0.5",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	}
}
