{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": true, // helpful for IDEs
		"rootDir": "..",
		"outDir": ".././types",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"skipLibCheck": true,
		"stripInternal": true, // hides /** @internal */ if you use it
		"resolveJsonModule": true // src/lib/issuer-registry.mjs imports data/issuers.json
	},
	// Declarations come from src/ only: dist/ is a minified bundle and the package's types
	// point at types/src/.
	"include": ["../src/**/*.mjs"]
}
